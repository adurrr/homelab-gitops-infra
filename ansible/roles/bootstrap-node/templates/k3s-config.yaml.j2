# =============================================================================
# K3s server/agent config - reduced pod /dev/shm size
# =============================================================================
# containerd's CRI runtime mounts a tmpfs shm into each pod at
# /run/k3s/containerd/io.containerd.grpc.v1.cri/sandboxes/<id>/shm.
# K3s default size is 64 MiB per pod. On a busy minipc with ~27 sandboxes
# that reserves up to ~1.7 GB of /run's 385 MB tmpfs, causing filesystem
# pressure alerts even though actual usage is low (tmpfs is lazy-allocated).
#
# Reducing to 32 MiB halves the worst-case reservation (~864 MB peak) and
# is safe for the current workload set: no JVMs, no databases, no explicit
# /dev/shm mounts in any deployed pod.
#
# Pods that genuinely need >32 MiB shm can override via per-pod emptyDir.
# Setting via kubelet-arg; restart of k3s service required to apply.
# Drain the node before restart in production.
# =============================================================================
kubelet-arg:
  - "pod-shm-size={{ k3s_pod_shm_size }}"
