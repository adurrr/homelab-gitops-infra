# =============================================================================
# systemd tmp.mount override: dynamic /run tmpfs sizing
# =============================================================================
# Default systemd sizes /run at 10% of RAM, which is ~385 MB on the 3.8 GB
# minipc node. K3s containerd creates a 64 MiB tmpfs shm mount per sandbox
# inside /run; with ~27 sandboxes the theoretical peak reservation is ~1.7 GB,
# which exceeds the default /run capacity and causes the
# NodeFilesystemAlmostOutOfSpace Prometheus alert (critical, 30m).
#
# Override size to 25% of RAM (~950 MB on minipc, ~2 GB on mamba),
# giving ~2.6x headroom while still leaving ~75% of RAM for page cache
# and application working sets. Dynamic sizing avoids hardcoding values
# that drift as node memory changes.
# =============================================================================
[Mount]
Options=mode=755,nosuid,nodev,strictatime,size={{ tmpfs_run_size }}
